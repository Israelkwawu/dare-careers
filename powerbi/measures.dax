// Create a calculated table first, hide its column, and put every measure on it:
//
// Measure = ROW ( "Measure", 1 )
//
// Each block below is one measure. Paste one block at a time.
// Monday, Trends, and the learner page must use these measures.
// A raw column does not know which week is selected.

// =============================================================================
// As Of Week Number
// =============================================================================
As Of Week Number =
VAR Selected = SELECTEDVALUE ( AsOfWeek[WeekNumber] )
VAR Cohorts = VALUES ( DimLearner[CohortKey] )
VAR Latest =
    CALCULATE (
        MAX ( DimProgramWeek[WeekNumber] ),
        REMOVEFILTERS ( DimProgramWeek ),
        TREATAS ( Cohorts, DimProgramWeek[CohortKey] )
    )
RETURN
    IF ( NOT ISBLANK ( Selected ), Selected, Latest )

// =============================================================================
// Learners
// =============================================================================
Learners = COUNTROWS ( DimLearner )

// =============================================================================
// Learners With Outcome
// =============================================================================
Learners With Outcome =
CALCULATE (
    COUNTROWS ( DimLearner ),
    NOT ISBLANK ( DimLearner[GraduationStatus] )
)

// =============================================================================
// Graduates
// =============================================================================
Graduates =
CALCULATE (
    COUNTROWS ( DimLearner ),
    DimLearner[GraduationStatus] = "Graduate"
)

// =============================================================================
// Non-Graduates
// =============================================================================
Non-Graduates =
CALCULATE (
    COUNTROWS ( DimLearner ),
    DimLearner[GraduationStatus] = "Non Graduate"
)

// =============================================================================
// Certified Learners
// =============================================================================
Certified Learners =
CALCULATE (
    COUNTROWS ( DimLearner ),
    DimLearner[CertificationStatus] = "Certified"
)

// =============================================================================
// Graduation Rate
// Learners with no status yet stay out of the rate.
// =============================================================================
Graduation Rate =
DIVIDE ( [Graduates], [Learners With Outcome] )

// =============================================================================
// Non-Graduation Rate
// =============================================================================
Non-Graduation Rate =
DIVIDE ( [Non-Graduates], [Learners With Outcome] )

// =============================================================================
// Certification Rate
// Certified learners divided by everyone with a recorded outcome, not only graduates.
// =============================================================================
Certification Rate =
DIVIDE ( [Certified Learners], [Learners With Outcome] )

// =============================================================================
// Attendance Rate
// All weeks currently loaded. The 30-minute rule is already on the row.
// =============================================================================
Attendance Rate =
DIVIDE ( SUM ( FactAttendance[Attended] ), COUNTROWS ( FactAttendance ) )

// =============================================================================
// Participation Rate
// =============================================================================
Participation Rate =
DIVIDE ( SUM ( FactParticipation[Participated] ), COUNTROWS ( FactParticipation ) )

// =============================================================================
// Lab Average
// =============================================================================
Lab Average =
CALCULATE (
    AVERAGE ( FactAssessment[Score] ),
    FactAssessment[AssessmentType] = "Lab"
)

// =============================================================================
// Quiz Average
// =============================================================================
Quiz Average =
CALCULATE (
    AVERAGE ( FactAssessment[Score] ),
    FactAssessment[AssessmentType] = "Quiz"
)

// =============================================================================
// Trailing Attendance Rate
// Last two program weeks, up to the selected week.
// =============================================================================
Trailing Attendance Rate =
VAR AsOf = [As Of Week Number]
VAR StartW = MAX ( 1, AsOf - 1 )
RETURN
    CALCULATE (
        DIVIDE ( SUM ( FactAttendance[Attended] ), COUNTROWS ( FactAttendance ) ),
        REMOVEFILTERS ( DimProgramWeek ),
        DimProgramWeek[WeekNumber] >= StartW,
        DimProgramWeek[WeekNumber] <= AsOf
    )

// =============================================================================
// Trailing Participation Rate
// =============================================================================
Trailing Participation Rate =
VAR AsOf = [As Of Week Number]
VAR StartW = MAX ( 1, AsOf - 1 )
RETURN
    CALCULATE (
        DIVIDE ( SUM ( FactParticipation[Participated] ), COUNTROWS ( FactParticipation ) ),
        REMOVEFILTERS ( DimProgramWeek ),
        DimProgramWeek[WeekNumber] >= StartW,
        DimProgramWeek[WeekNumber] <= AsOf
    )

// =============================================================================
// Trailing Lab Average
// =============================================================================
Trailing Lab Average =
VAR AsOf = [As Of Week Number]
VAR StartW = MAX ( 1, AsOf - 1 )
RETURN
    CALCULATE (
        CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Lab" ),
        REMOVEFILTERS ( DimProgramWeek ),
        DimProgramWeek[WeekNumber] >= StartW,
        DimProgramWeek[WeekNumber] <= AsOf
    )

// =============================================================================
// Trailing Quiz Average
// =============================================================================
Trailing Quiz Average =
VAR AsOf = [As Of Week Number]
VAR StartW = MAX ( 1, AsOf - 1 )
RETURN
    CALCULATE (
        CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Quiz" ),
        REMOVEFILTERS ( DimProgramWeek ),
        DimProgramWeek[WeekNumber] >= StartW,
        DimProgramWeek[WeekNumber] <= AsOf
    )

// =============================================================================
// Trailing Coursework Average
// The lab average and the quiz average, weighted equally.
// =============================================================================
Trailing Coursework Average =
VAR Lab = [Trailing Lab Average]
VAR Quiz = [Trailing Quiz Average]
VAR Denominator =
    IF ( ISBLANK ( Lab ), 0, 1 ) + IF ( ISBLANK ( Quiz ), 0, 1 )
RETURN
    IF (
        Denominator = 0,
        BLANK (),
        DIVIDE ( IF ( ISBLANK ( Lab ), 0, Lab ) + IF ( ISBLANK ( Quiz ), 0, Quiz ), Denominator )
    )

// =============================================================================
// Is At Risk
// 1 when two bars are missed. 0 otherwise, including before week 3.
// Does not read graduation or certification.
// =============================================================================
Is At Risk =
VAR AsOf = [As Of Week Number]
VAR Att = [Trailing Attendance Rate]
VAR Part = [Trailing Participation Rate]
VAR Coursework = [Trailing Coursework Average]
VAR Hits =
    IF ( NOT ISBLANK ( Att ) && Att < 0.70, 1, 0 )
        + IF ( NOT ISBLANK ( Part ) && Part < 0.60, 1, 0 )
        + IF ( NOT ISBLANK ( Coursework ) && Coursework < 40, 1, 0 )
RETURN
    IF ( AsOf < 3, 0, IF ( Hits >= 2, 1, 0 ) )

// =============================================================================
// Call This Week
// =============================================================================
Call This Week =
IF (
    [As Of Week Number] < 3,
    "Too early",
    IF ( [Is At Risk] = 1, "Call", "No call" )
)

// =============================================================================
// Call Reason
// One sentence for the trainer, whether the learner is on the list or not.
// =============================================================================
Call Reason =
VAR AsOf = [As Of Week Number]
VAR StartW = MAX ( 1, AsOf - 1 )
VAR Att = [Trailing Attendance Rate]
VAR Part = [Trailing Participation Rate]
VAR Coursework = [Trailing Coursework Average]
VAR AttMiss = NOT ISBLANK ( Att ) && Att < 0.70
VAR PartMiss = NOT ISBLANK ( Part ) && Part < 0.60
VAR WorkMiss = NOT ISBLANK ( Coursework ) && Coursework < 40
VAR Hits =
    IF ( AttMiss, 1, 0 ) + IF ( PartMiss, 1, 0 ) + IF ( WorkMiss, 1, 0 )
VAR Detail =
    "Over weeks " & StartW & " to " & AsOf
        & ", in class " & IF ( ISBLANK ( Att ), "n/a", FORMAT ( Att, "0%" ) )
        & ", took part " & IF ( ISBLANK ( Part ), "n/a", FORMAT ( Part, "0%" ) )
        & ", lab and quiz together " & IF ( ISBLANK ( Coursework ), "n/a", FORMAT ( Coursework, "0" ) )
        & ". "
VAR Which =
    IF ( AttMiss, "In class under 70%. ", "" )
        & IF ( PartMiss, "Took part under 60%. ", "" )
        & IF ( WorkMiss, "Coursework under 40. ", "" )
RETURN
    IF (
        AsOf < 3,
        "Too early for a call. The check starts at week 3, and calls wait until week 4.",
        Detail
            & IF (
                Hits >= 2,
                "Call. " & Which,
                "No call. Fewer than two bars were missed."
            )
    )

// =============================================================================
// Learners Flagged
// =============================================================================
Learners Flagged =
COUNTROWS ( FILTER ( DimLearner, [Is At Risk] = 1 ) )

// =============================================================================
// Monday Headline
// =============================================================================
Monday Headline =
VAR N = [Learners Flagged]
VAR AsOf = [As Of Week Number]
RETURN
    IF (
        AsOf < 3,
        "Too early for a call list. Wait until week 4.",
        IF (
            N = 0,
            "No calls this week. Nobody missed two of the three bars.",
            FORMAT ( N, "0" ) & IF ( N = 1, " call this week.", " calls this week." )
        )
    )

// =============================================================================
// Trainer Time
// Half an hour a call. An empty list books nobody.
// =============================================================================
Trainer Time =
VAR N = [Learners Flagged]
RETURN
    IF (
        [As Of Week Number] < 3 || N = 0,
        "No trainer time.",
        FORMAT ( N, "0" ) & IF ( N = 1, " call, about ", " calls, about " )
            & FORMAT ( N * 0.5, "0.0" ) & " hours."
    )

// =============================================================================
// Flagged Who Did Not Graduate
// Hindsight only. Not an input to Is At Risk.
// =============================================================================
Flagged Who Did Not Graduate =
COUNTROWS (
    FILTER (
        DimLearner,
        [Is At Risk] = 1 && DimLearner[GraduationStatus] = "Non Graduate"
    )
)

// =============================================================================
// Non-Graduates Missed
// =============================================================================
Non-Graduates Missed =
COUNTROWS (
    FILTER (
        DimLearner,
        [Is At Risk] <> 1 && DimLearner[GraduationStatus] = "Non Graduate"
    )
)

// =============================================================================
// Hindsight
// =============================================================================
Hindsight =
VAR Known = [Learners With Outcome]
VAR Flagged = [Learners Flagged]
VAR Hit = [Flagged Who Did Not Graduate]
VAR Missed = [Non-Graduates Missed]
RETURN
    IF (
        Known = 0,
        "Outcomes are not in yet. This list only shows who has gone quiet.",
        "Of the " & Flagged & " on the list, " & Hit & " did not graduate. "
            & Missed & " learners who did not graduate are not on the list. "
            & "That comparison uses the final outcome, which was not known on the Monday."
    )

// =============================================================================
// Outcome (known only after the program)
// =============================================================================
Outcome (known only after the program) =
VAR GradStatus = SELECTEDVALUE ( DimLearner[GraduationStatus] )
VAR Certified = SELECTEDVALUE ( DimLearner[CertificationStatus] )
RETURN
    IF (
        ISBLANK ( GradStatus ),
        "In progress",
        IF ( GradStatus = "Non Graduate", "Did not graduate", GradStatus )
            & ", "
            & IF (
                Certified = "Certified",
                "certified",
                IF ( Certified = "Not Certified", "not certified", Certified )
            )
    )

// =============================================================================
// Week Attendance Rate
// One week on a chart. Blank after the selected week.
// =============================================================================
Week Attendance Rate =
VAR W = SELECTEDVALUE ( DimProgramWeek[WeekNumber] )
RETURN
    IF (
        ISBLANK ( W ) || W > [As Of Week Number],
        BLANK (),
        DIVIDE ( SUM ( FactAttendance[Attended] ), COUNTROWS ( FactAttendance ) )
    )

// =============================================================================
// Week Participation Rate
// =============================================================================
Week Participation Rate =
VAR W = SELECTEDVALUE ( DimProgramWeek[WeekNumber] )
RETURN
    IF (
        ISBLANK ( W ) || W > [As Of Week Number],
        BLANK (),
        DIVIDE ( SUM ( FactParticipation[Participated] ), COUNTROWS ( FactParticipation ) )
    )

// =============================================================================
// Week Lab Average
// =============================================================================
Week Lab Average =
VAR W = SELECTEDVALUE ( DimProgramWeek[WeekNumber] )
RETURN
    IF (
        ISBLANK ( W ) || W > [As Of Week Number],
        BLANK (),
        CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Lab" )
    )

// =============================================================================
// Week Quiz Average
// =============================================================================
Week Quiz Average =
VAR W = SELECTEDVALUE ( DimProgramWeek[WeekNumber] )
RETURN
    IF (
        ISBLANK ( W ) || W > [As Of Week Number],
        BLANK (),
        CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Quiz" )
    )

// =============================================================================
// Week Is On Or Before As Of
// Put this on the Trends visual filter, equal to 1, so later weeks stay off the axis.
// =============================================================================
Week Is On Or Before As Of =
VAR W = SELECTEDVALUE ( DimProgramWeek[WeekNumber] )
RETURN
    IF ( NOT ISBLANK ( W ) && W <= [As Of Week Number], 1, 0 )

// =============================================================================
// Cohort Anomaly
// More than 8 points behind the average of earlier weeks, and only once three earlier weeks exist.
// =============================================================================
Cohort Anomaly =
VAR AsOf = [As Of Week Number]
RETURN
    IF (
        AsOf < 4,
        "Group notes start at week 4, once three earlier weeks exist.",
        VAR Lines =
            CONCATENATEX (
                SUMMARIZE ( DimLearner, DimLearner[CohortName], DimLearner[Track] ),
                VAR CohortLabel = DimLearner[CohortName]
                VAR TrackLabel = DimLearner[Track]
                VAR PriorWeeks =
                    FILTER ( ALL ( DimProgramWeek[WeekNumber] ), DimProgramWeek[WeekNumber] < AsOf )
                VAR PriorN = COUNTROWS ( PriorWeeks )
                VAR PartNow =
                    CALCULATE (
                        DIVIDE ( SUM ( FactParticipation[Participated] ), COUNTROWS ( FactParticipation ) ),
                        REMOVEFILTERS ( DimProgramWeek ),
                        DimProgramWeek[WeekNumber] = AsOf
                    )
                VAR PartPrior =
                    AVERAGEX (
                        PriorWeeks,
                        VAR W = DimProgramWeek[WeekNumber]
                        RETURN
                            CALCULATE (
                                DIVIDE ( SUM ( FactParticipation[Participated] ), COUNTROWS ( FactParticipation ) ),
                                REMOVEFILTERS ( DimProgramWeek ),
                                DimProgramWeek[WeekNumber] = W
                            )
                    )
                VAR AttNow =
                    CALCULATE (
                        DIVIDE ( SUM ( FactAttendance[Attended] ), COUNTROWS ( FactAttendance ) ),
                        REMOVEFILTERS ( DimProgramWeek ),
                        DimProgramWeek[WeekNumber] = AsOf
                    )
                VAR AttPrior =
                    AVERAGEX (
                        PriorWeeks,
                        VAR W = DimProgramWeek[WeekNumber]
                        RETURN
                            CALCULATE (
                                DIVIDE ( SUM ( FactAttendance[Attended] ), COUNTROWS ( FactAttendance ) ),
                                REMOVEFILTERS ( DimProgramWeek ),
                                DimProgramWeek[WeekNumber] = W
                            )
                    )
                VAR LabNow =
                    CALCULATE (
                        CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Lab" ),
                        REMOVEFILTERS ( DimProgramWeek ),
                        DimProgramWeek[WeekNumber] = AsOf
                    )
                VAR LabPrior =
                    AVERAGEX (
                        PriorWeeks,
                        VAR W = DimProgramWeek[WeekNumber]
                        RETURN
                            CALCULATE (
                                CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Lab" ),
                                REMOVEFILTERS ( DimProgramWeek ),
                                DimProgramWeek[WeekNumber] = W
                            )
                    )
                VAR QuizNow =
                    CALCULATE (
                        CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Quiz" ),
                        REMOVEFILTERS ( DimProgramWeek ),
                        DimProgramWeek[WeekNumber] = AsOf
                    )
                VAR QuizPrior =
                    AVERAGEX (
                        PriorWeeks,
                        VAR W = DimProgramWeek[WeekNumber]
                        RETURN
                            CALCULATE (
                                CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Quiz" ),
                                REMOVEFILTERS ( DimProgramWeek ),
                                DimProgramWeek[WeekNumber] = W
                            )
                    )
                RETURN
                    IF (
                        PriorN < 3,
                        "",
                        IF (
                            NOT ISBLANK ( PartPrior ) && NOT ISBLANK ( PartNow ) && PartPrior - PartNow > 0.08,
                            TrackLabel & ", " & CohortLabel & ", week " & AsOf & ": participation "
                                & FORMAT ( PartNow, "0%" ) & ", against " & FORMAT ( PartPrior, "0%" )
                                & " in earlier weeks. ",
                            ""
                        )
                            & IF (
                                NOT ISBLANK ( AttPrior ) && NOT ISBLANK ( AttNow ) && AttPrior - AttNow > 0.08,
                                TrackLabel & ", " & CohortLabel & ", week " & AsOf & ": attendance "
                                    & FORMAT ( AttNow, "0%" ) & ", against " & FORMAT ( AttPrior, "0%" )
                                    & " in earlier weeks. ",
                                ""
                            )
                            & IF (
                                NOT ISBLANK ( LabPrior ) && NOT ISBLANK ( LabNow ) && LabPrior - LabNow > 8,
                                TrackLabel & ", " & CohortLabel & ", week " & AsOf & ": labs "
                                    & FORMAT ( LabNow, "0" ) & ", against " & FORMAT ( LabPrior, "0" )
                                    & " in earlier weeks. ",
                                ""
                            )
                            & IF (
                                NOT ISBLANK ( QuizPrior ) && NOT ISBLANK ( QuizNow ) && QuizPrior - QuizNow > 8,
                                TrackLabel & ", " & CohortLabel & ", week " & AsOf & ": quizzes "
                                    & FORMAT ( QuizNow, "0" ) & ", against " & FORMAT ( QuizPrior, "0" )
                                    & " in earlier weeks. ",
                                ""
                            )
                    ),
                ""
            )
        RETURN
            IF (
                Lines = "",
                "Nothing in this week is more than 8 points behind the earlier weeks.",
                Lines
            )
    )

// =============================================================================
// Unmatched Participation Names
// =============================================================================
Unmatched Participation Names =
VAR N =
    CALCULATE (
        DISTINCTCOUNT ( DataExceptions[RawName] ),
        DataExceptions[Reason] = "Participation name did not match a learner"
            || DataExceptions[Reason] = "Participation name matched more than one learner",
        TREATAS ( VALUES ( DimLearner[Track] ), DataExceptions[Track] ),
        TREATAS ( VALUES ( DimLearner[CohortKey] ), DataExceptions[CohortKey] )
    )
RETURN
    IF ( ISBLANK ( N ), 0, N )

// =============================================================================
// Unreadable Values
// =============================================================================
Unreadable Values =
VAR N =
    CALCULATE (
        COUNTROWS ( DataExceptions ),
        CONTAINSSTRING ( DataExceptions[Reason], "could not be read" ),
        TREATAS ( VALUES ( DimLearner[Track] ), DataExceptions[Track] ),
        TREATAS ( VALUES ( DimLearner[CohortKey] ), DataExceptions[CohortKey] )
    )
RETURN
    IF ( ISBLANK ( N ), 0, N )

// =============================================================================
// Feed Learners
// Pass the feed name from the card title by using the four measures below, not this pattern.
// =============================================================================
Live Class Learners =
CALCULATE (
    SUM ( FeedCheck[LearnerCount] ),
    FeedCheck[Feed] = "Live class",
    TREATAS ( VALUES ( DimLearner[Track] ), FeedCheck[Track] ),
    TREATAS ( VALUES ( DimLearner[CohortKey] ), FeedCheck[CohortKey] )
)

// =============================================================================
// Live Class Days
// =============================================================================
Live Class Days =
CALCULATE (
    SUM ( FeedCheck[DayOrWeekCount] ),
    FeedCheck[Feed] = "Live class",
    TREATAS ( VALUES ( DimLearner[Track] ), FeedCheck[Track] ),
    TREATAS ( VALUES ( DimLearner[CohortKey] ), FeedCheck[CohortKey] )
)

// =============================================================================
// Participation Learners
// =============================================================================
Participation Learners =
CALCULATE (
    SUM ( FeedCheck[LearnerCount] ),
    FeedCheck[Feed] = "Participation",
    TREATAS ( VALUES ( DimLearner[Track] ), FeedCheck[Track] ),
    TREATAS ( VALUES ( DimLearner[CohortKey] ), FeedCheck[CohortKey] )
)

// =============================================================================
// Participation Days
// =============================================================================
Participation Days =
CALCULATE (
    SUM ( FeedCheck[DayOrWeekCount] ),
    FeedCheck[Feed] = "Participation",
    TREATAS ( VALUES ( DimLearner[Track] ), FeedCheck[Track] ),
    TREATAS ( VALUES ( DimLearner[CohortKey] ), FeedCheck[CohortKey] )
)

// =============================================================================
// Assessment Learners
// =============================================================================
Assessment Learners =
CALCULATE (
    SUM ( FeedCheck[LearnerCount] ),
    FeedCheck[Feed] = "Assessments",
    TREATAS ( VALUES ( DimLearner[Track] ), FeedCheck[Track] ),
    TREATAS ( VALUES ( DimLearner[CohortKey] ), FeedCheck[CohortKey] )
)

// =============================================================================
// Status Learners
// =============================================================================
Status Learners =
CALCULATE (
    SUM ( FeedCheck[LearnerCount] ),
    FeedCheck[Feed] = "Status",
    TREATAS ( VALUES ( DimLearner[Track] ), FeedCheck[Track] ),
    TREATAS ( VALUES ( DimLearner[CohortKey] ), FeedCheck[CohortKey] )
)

// =============================================================================
// Files Agree
// The line that says whether the next drop can be trusted.
// =============================================================================
Files Agree =
"Roster " & [Learners]
    & ". Live class " & [Live Class Learners] & " learners, " & [Live Class Days] & " class days across the tracks in view. "
    & "Participation " & [Participation Learners] & " learners, " & [Participation Days] & " class days, "
    & [Unmatched Participation Names] & " names unmatched. "
    & "Assessments " & [Assessment Learners] & " learners. Status " & [Status Learners] & " learners. "
    & "Unreadable values " & [Unreadable Values] & "."
