	measure 'Files Agree' = ```
			
			"Roster " & [Learners]
			    & ". Live class " & [Live Class Learners] & " learners, " & [Live Class Days] & " class days across the tracks in view. "
			    & "Participation " & [Participation Learners] & " learners, " & [Participation Days] & " class days, "
			    & [Unmatched Participation Names] & " names unmatched. "
			    & "Assessments " & [Assessment Learners] & " learners. Status " & [Status Learners] & " learners. "
			    & "Unreadable values " & [Unreadable Values] & "."
			
			```
