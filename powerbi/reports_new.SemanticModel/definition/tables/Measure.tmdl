	measure 'Trailing Attendance Rate' = ```
			
			VAR AsOf = [As Of Week Number]
			VAR StartW = MAX ( 1, AsOf - 1 )
			RETURN
			    CALCULATE (
			        DIVIDE ( SUM ( FactAttendance[Attended] ), COUNTROWS ( FactAttendance ) ),
			        REMOVEFILTERS ( DimProgramWeek ),
			        DimProgramWeek[WeekNumber] >= StartW,
			        DimProgramWeek[WeekNumber] <= AsOf
			    )
			
			```
		lineageTag: 99e1616b-8cbc-40dc-8701-54aeac523636

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trailing Participation Rate' = ```
			
			VAR AsOf = [As Of Week Number]
			VAR StartW = MAX ( 1, AsOf - 1 )
			RETURN
			    CALCULATE (
			        DIVIDE ( SUM ( FactParticipation[Participated] ), COUNTROWS ( FactParticipation ) ),
			        REMOVEFILTERS ( DimProgramWeek ),
			        DimProgramWeek[WeekNumber] >= StartW,
			        DimProgramWeek[WeekNumber] <= AsOf
			    )
			
			```
		lineageTag: 7a0f8a2c-dd6d-46dd-8d9e-132e564bf2b9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trailing Lab Average' = ```
			
			VAR AsOf = [As Of Week Number]
			VAR StartW = MAX ( 1, AsOf - 1 )
			RETURN
