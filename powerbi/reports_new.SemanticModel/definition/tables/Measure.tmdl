	measure 'Monday Headline' = ```
			
			VAR N = [Learners Flagged]
			VAR AsOf = [As Of Week Number]
			RETURN
			    IF (
			        AsOf < 3,
			        "Too early for a call list. Wait until week 4.",
			        IF (
			            N = 0,
			            "No calls this week. Nobody missed two of the three bars.",
			            FORMAT ( N, "0" ) & IF ( N = 1, " call this week.", " calls this week." )
			        )
			    )
			
			```
		lineageTag: b8270f9e-351d-4623-9711-4db18fc01ac6

	measure 'Trainer Time' = ```
			
			VAR N = [Learners Flagged]
			RETURN
			    IF (
			        [As Of Week Number] < 3 || N = 0,
			        "No trainer time.",
			        FORMAT ( N, "0" ) & IF ( N = 1, " call, about ", " calls, about " )
			            & FORMAT ( N * 0.5, "0.0" ) & " hours."
			    )
			
			```
		lineageTag: 76a0acb6-9f97-4eb6-8693-594d361e763f

