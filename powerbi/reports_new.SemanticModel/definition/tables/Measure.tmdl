table Measure
	lineageTag: 6d8e8ef0-b731-454b-8d44-d96c341e10a7

	measure 'As Of Week Number' = ```
			
			VAR Selected = SELECTEDVALUE ( AsOfWeek[WeekNumber] )
			VAR Cohorts = VALUES ( DimLearner[CohortKey] )
			VAR Latest =
			    CALCULATE (
			        MAX ( DimProgramWeek[WeekNumber] ),
			        REMOVEFILTERS ( DimProgramWeek ),
			        TREATAS ( Cohorts, DimProgramWeek[CohortKey] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( Selected ), Selected, Latest )
			
			```
		formatString: 0
		lineageTag: 740de68a-cb8b-4643-a37f-7e199d8c7e45

	measure Learners = COUNTROWS ( DimLearner )
