	measure 'Cohort Anomaly' = ```
			
			VAR AsOf = [As Of Week Number]
			RETURN
			    IF (
			        AsOf < 4,
			        "Group notes start at week 4, once three earlier weeks exist.",
			        VAR Lines =
			            CONCATENATEX (
			                SUMMARIZE ( DimLearner, DimLearner[CohortName], DimLearner[Track] ),
			                VAR CohortLabel = DimLearner[CohortName]
			                VAR TrackLabel = DimLearner[Track]
			                VAR PriorWeeks =
			                    FILTER ( ALL ( DimProgramWeek[WeekNumber] ), DimProgramWeek[WeekNumber] < AsOf )
			                VAR PriorN = COUNTROWS ( PriorWeeks )
			                VAR PartNow =
			                    CALCULATE (
			                        DIVIDE ( SUM ( FactParticipation[Participated] ), COUNTROWS ( FactParticipation ) ),
			                        REMOVEFILTERS ( DimProgramWeek ),
			                        DimProgramWeek[WeekNumber] = AsOf
			                    )
			                VAR PartPrior =
			                    AVERAGEX (
			                        PriorWeeks,
			                        VAR W = DimProgramWeek[WeekNumber]
			                        RETURN
			                            CALCULATE (
			                                DIVIDE ( SUM ( FactParticipation[Participated] ), COUNTROWS ( FactParticipation ) ),
			                                REMOVEFILTERS ( DimProgramWeek ),
			                                DimProgramWeek[WeekNumber] = W
			                            )
			                    )
			                VAR AttNow =
			                    CALCULATE (
			                        DIVIDE ( SUM ( FactAttendance[Attended] ), COUNTROWS ( FactAttendance ) ),
			                        REMOVEFILTERS ( DimProgramWeek ),
			                        DimProgramWeek[WeekNumber] = AsOf
			                    )
			                VAR AttPrior =
			                    AVERAGEX (
			                        PriorWeeks,
			                        VAR W = DimProgramWeek[WeekNumber]
			                        RETURN
			                            CALCULATE (
			                                DIVIDE ( SUM ( FactAttendance[Attended] ), COUNTROWS ( FactAttendance ) ),
			                                REMOVEFILTERS ( DimProgramWeek ),
			                                DimProgramWeek[WeekNumber] = W
			                            )
			                    )
			                VAR LabNow =
			                    CALCULATE (
			                        CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Lab" ),
			                        REMOVEFILTERS ( DimProgramWeek ),
			                        DimProgramWeek[WeekNumber] = AsOf
			                    )
			                VAR LabPrior =
			                    AVERAGEX (
			                        PriorWeeks,
			                        VAR W = DimProgramWeek[WeekNumber]
			                        RETURN
			                            CALCULATE (
			                                CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Lab" ),
			                                REMOVEFILTERS ( DimProgramWeek ),
			                                DimProgramWeek[WeekNumber] = W
			                            )
			                    )
			                VAR QuizNow =
			                    CALCULATE (
			                        CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Quiz" ),
			                        REMOVEFILTERS ( DimProgramWeek ),
			                        DimProgramWeek[WeekNumber] = AsOf
			                    )
			                VAR QuizPrior =
			                    AVERAGEX (
			                        PriorWeeks,
			                        VAR W = DimProgramWeek[WeekNumber]
			                        RETURN
			                            CALCULATE (
			                                CALCULATE ( AVERAGE ( FactAssessment[Score] ), FactAssessment[AssessmentType] = "Quiz" ),
			                                REMOVEFILTERS ( DimProgramWeek ),
			                                DimProgramWeek[WeekNumber] = W
			                            )
			                    )
			                RETURN
			                    IF (
			                        PriorN < 3,
			                        "",
			                        IF (
			                            NOT ISBLANK ( PartPrior ) && NOT ISBLANK ( PartNow ) && PartPrior - PartNow > 0.08,
			                            TrackLabel & ", " & CohortLabel & ", week " & AsOf & ": participation "
			                                & FORMAT ( PartNow, "0%" ) & ", against " & FORMAT ( PartPrior, "0%" )
			                                & " in earlier weeks. ",
			                            ""
			                        )
			                            & IF (
			                                NOT ISBLANK ( AttPrior ) && NOT ISBLANK ( AttNow ) && AttPrior - AttNow > 0.08,
			                                TrackLabel & ", " & CohortLabel & ", week " & AsOf & ": attendance "
			                                    & FORMAT ( AttNow, "0%" ) & ", against " & FORMAT ( AttPrior, "0%" )
			                                    & " in earlier weeks. ",
			                                ""
			                            )
			                            & IF (
			                                NOT ISBLANK ( LabPrior ) && NOT ISBLANK ( LabNow ) && LabPrior - LabNow > 8,
			                                TrackLabel & ", " & CohortLabel & ", week " & AsOf & ": labs "
			                                    & FORMAT ( LabNow, "0" ) & ", against " & FORMAT ( LabPrior, "0" )
			                                    & " in earlier weeks. ",
			                                ""
			                            )
			                            & IF (
			                                NOT ISBLANK ( QuizPrior ) && NOT ISBLANK ( QuizNow ) && QuizPrior - QuizNow > 8,
			                                TrackLabel & ", " & CohortLabel & ", week " & AsOf & ": quizzes "
			                                    & FORMAT ( QuizNow, "0" ) & ", against " & FORMAT ( QuizPrior, "0" )
			                                    & " in earlier weeks. ",
			                                ""
			                            )
			                    ),
			                ""
			            )
			        RETURN
			            IF (
			                Lines = "",
			                "Nothing in this week is more than 8 points behind the earlier weeks.",
			                Lines
			            )
			    )
			
			```
		lineageTag: 1be601bb-e6a4-4493-b796-01bba5012e3e

	measure 'Unmatched Participation Names' = ```
			
			VAR N =
			    CALCULATE (
			        DISTINCTCOUNT ( DataExceptions[RawName] ),
			        DataExceptions[Reason] = "Participation name did not match a learner"
			            || DataExceptions[Reason] = "Participation name matched more than one learner",
			        TREATAS ( VALUES ( DimLearner[Track] ), DataExceptions[Track] ),
			        TREATAS ( VALUES ( DimLearner[CohortKey] ), DataExceptions[CohortKey] )
			    )
			RETURN
			    IF ( ISBLANK ( N ), 0, N )
			
			```
		formatString: 0
		lineageTag: ee1fea6d-4b71-46e4-8989-64f9f6966273

	measure 'Unreadable Values' = ```
			
