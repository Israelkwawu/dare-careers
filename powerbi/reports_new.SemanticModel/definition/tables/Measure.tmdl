	measure 'Trailing Coursework Average' = ```
			
			VAR Lab = [Trailing Lab Average]
			VAR Quiz = [Trailing Quiz Average]
			VAR Denominator =
			    IF ( ISBLANK ( Lab ), 0, 1 ) + IF ( ISBLANK ( Quiz ), 0, 1 )
			RETURN
			    IF (
			        Denominator = 0,
			        BLANK (),
			        DIVIDE ( IF ( ISBLANK ( Lab ), 0, Lab ) + IF ( ISBLANK ( Quiz ), 0, Quiz ), Denominator )
			    )
			
			```
		lineageTag: 7efa6433-5065-4ada-9e11-0670461f5549

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Is At Risk' = ```
			
			VAR AsOf = [As Of Week Number]
			VAR Att = [Trailing Attendance Rate]
			VAR Part = [Trailing Participation Rate]
			VAR Coursework = [Trailing Coursework Average]
			VAR Hits =
			    IF ( NOT ISBLANK ( Att ) && Att < 0.70, 1, 0 )
			        + IF ( NOT ISBLANK ( Part ) && Part < 0.60, 1, 0 )
			        + IF ( NOT ISBLANK ( Coursework ) && Coursework < 40, 1, 0 )
			RETURN
			    IF ( AsOf < 3, 0, IF ( Hits >= 2, 1, 0 ) )
			
			```
		formatString: 0
		lineageTag: 9447a6b0-3bd6-43c7-afe7-f7a29d64458a

	measure 'Call This Week' = ```
			
			IF (
			    [As Of Week Number] < 3,
			    "Too early",
			    IF ( [Is At Risk] = 1, "Call", "No call" )
			)
			
			```
		lineageTag: b323816a-b75f-4e55-bc4a-c18c8bdcc5e4

	measure 'Call Reason' = ```
			
			VAR AsOf = [As Of Week Number]
			VAR StartW = MAX ( 1, AsOf - 1 )
			VAR Att = [Trailing Attendance Rate]
			VAR Part = [Trailing Participation Rate]
			VAR Coursework = [Trailing Coursework Average]
			VAR AttMiss = NOT ISBLANK ( Att ) && Att < 0.70
			VAR PartMiss = NOT ISBLANK ( Part ) && Part < 0.60
			VAR WorkMiss = NOT ISBLANK ( Coursework ) && Coursework < 40
			VAR Hits =
			    IF ( AttMiss, 1, 0 ) + IF ( PartMiss, 1, 0 ) + IF ( WorkMiss, 1, 0 )
			VAR Detail =
			    "Over weeks " & StartW & " to " & AsOf
			        & ", in class " & IF ( ISBLANK ( Att ), "n/a", FORMAT ( Att, "0%" ) )
			        & ", took part " & IF ( ISBLANK ( Part ), "n/a", FORMAT ( Part, "0%" ) )
			        & ", lab and quiz together " & IF ( ISBLANK ( Coursework ), "n/a", FORMAT ( Coursework, "0" ) )
			        & ". "
			VAR Which =
			    IF ( AttMiss, "In class under 70%. ", "" )
			        & IF ( PartMiss, "Took part under 60%. ", "" )
			        & IF ( WorkMiss, "Coursework under 40. ", "" )
			RETURN
			    IF (
			        AsOf < 3,
			        "Too early for a call. The check starts at week 3, and calls wait until week 4.",
			        Detail
			            & IF (
			                Hits >= 2,
			                "Call. " & Which,
			                "No call. Fewer than two bars were missed."
			            )
			    )
			
			```
		lineageTag: 7b548c01-0c1e-4b05-8e47-19bb41dc6e4b

	measure 'Learners Flagged' = ```
			
			COUNTROWS ( FILTER ( DimLearner, [Is At Risk] = 1 ) )
			
