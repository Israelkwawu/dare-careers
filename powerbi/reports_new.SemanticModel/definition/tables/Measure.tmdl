		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trailing Quiz Average' = ```
			
			VAR AsOf = [As Of Week Number]
			VAR StartW = MAX ( 1, AsOf - 1 )
			RETURN
